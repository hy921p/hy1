# =====================================================
# AI 智面平台 · 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 除 AI_API_KEY 外均有默认值，可直接跑通本地/Docker。
# =====================================================

# ---------- 基础 ----------
NODE_ENV=production
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=*

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456        # docker-compose 里初始化 root 密码
DB_HOST=mysql                     # 本地直连用 127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=ai_interview_coach

# ---------- JWT ----------
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change-me-admin-secret
ADMIN_JWT_EXPIRES_IN=12h

# ---------- DeepSeek（必填） ----------
AI_API_KEY=sk-你的DeepSeekKey
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT=60000
AI_MAX_TOKENS=4096
AI_RATE_WINDOW=60000
AI_RATE_MAX=10
AI_ENABLED=true

# ---------- V1.1 RAG 向量检索（§10.2） ----------
# embedding：auto=远程失败自动降级本地哈希；remote=仅远程；hash=仅本地
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=                  # 留空则纯本地哈希向量（离线可用）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
# 向量库：qdrant=Qdrant（生产，Docker 内置）；mysql=MySQL JSON 列 + JS 余弦（轻量兜底）
VECTOR_MODE=qdrant
QDRANT_URL=http://qdrant:6333      # 本地直连用 http://localhost:6333
QDRANT_COLLECTION=knowledge
VECTOR_TOP_K=5

# ---------- V2.0 Agent 面试官（§10.3） ----------
AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=4
